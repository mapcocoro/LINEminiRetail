# Only NEXT_PUBLIC_* values belong in .env files.
# OpenNext bundles every .env value into the Cloudflare Worker, so `npm run deploy` stops if anything else is here.
#   - Local settings (DB, Basic auth, DEMO_MODE): .dev.vars  (see .dev.vars.example)
#   - Production secrets: `npx wrangler secret put <NAME>` (DATABASE_URL, BASIC_AUTH_USER, BASIC_AUTH_PASSWORD, LINE_LOGIN_CHANNEL_ID)

# LINE LIFF (public, inlined at build time)
NEXT_PUBLIC_LIFF_ID="your-liff-id-here"
